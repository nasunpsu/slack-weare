<div class="ui padded grid">
  <div class="ui inverted borderless top fixed menu navbar">
    <a class="header item" href="/home"><img src="images/weconnect@2x.png" class="nav-logo"></a>
    <div class="right menu">
      <div class="ui floating dropdown item">
        <i class="dropdown icon"></i>
        <div class="default text">Filter by ... </div>
        <div class="menu">
          <div class="item">
            <i class="dropdown icon"></i>

            <span class="text">Select channel</span>

            <div class="scroll right menu">
              {{#each channels_info.channel_list as |channel|}}
              <div class="channel-option item" value="{{channel.cid}}"> <i class="slack hash icon"></i>{{channel.cname}}
              </div>
              {{/each}}
            </div>
          </div>
          <div class="item">
            <span class="text">Select group</span>
            <i class="dropdown icon"></i>
            <div class="scroll right menu">
              <div class="item"><i class="users icon"></i>Aegean</div>
              <div class="item"><i class="users icon"></i>Balinese</div>
              <div class="item"><i class="users icon"></i>Persian</div>
            </div>
          </div>
        </div>
      </div>
      <div class="ui dropdown item">
        Connect
        <i class="dropdown icon"></i>
        <div class="menu">
          <a class="item" href="/tablelist">Table</a>
          <a class="item" href="/network">Similarity</a>
          <a class="item" href="/temporal">Timezones</a>
          <a class="item">Map</a>
        </div>
      </div>
      <div class="ui dropdown item">
        Profile
        <i class="dropdown icon"></i>
        <div class="menu">
          <a class="item"><i class="edit icon"></i> Edit Profile</a>
          <a class="item"><i class="calendar alternate outline icon"></i> My meetings</a>
          <a class="item"><i class="settings icon"></i> Account Settings</a>
        </div>
      </div>
      <a class="item"
        href="https://docs.google.com/document/d/1-nCasqUcPrLYbhDuAm9SmuvY0S5ZOevPLbp52-PpZLM/edit?usp=sharing"
        target="_blank"> Help</a>
    </div>
  </div>
</div>

