<style type="text/css">
	

	circle.node {
		fill: lightsteelblue;
		stroke: #555;
		stroke-width: 3px;
	}

	path.hull {
		fill: lightsteelblue;
		fill-opacity: 0.3;
	}

	line.link {
		stroke: #333;
		stroke-opacity: 0.5;
		pointer-events: none;
	}

	.node text {
		font: 15px helvetica;
	}
	.node:not(:hover) text {
        display: none;
      }
</style>

<body>
		<div id="nw-wrapper">
		<!-- <label><input style="width:240px;" id = "strength" type="range" min="0" max="1" step="any" value="0.5"> Link Strength</label> -->
			<div class="nw-filter-wrapper">
            <h3>Filter Peers By</h3>
				<div class="filters">
					<form id="checkboxes">
						<div class="ui checkbox">
							<input type="checkbox" id="locationCheck">
							<label class="form-check-label" for="locationCheck"><a class="ui red empty circular label mini"></a> Location</label>
						</div>
						<div class="ui checkbox">
							<input type="checkbox" id="majorCheck">
							<label for="majorCheck"><a class="ui orange empty circular label mini"></a> Major</label>
						</div>
						{{#each this.channelNames}}
							<div class="ui checkbox">
								<input type="checkbox">
								<label>{{this}}</label>
							</div>
						{{/each}}
					</form>
				</div>
				<div class="ui category search nw-search">
					<div class="ui icon right labeled input nw-search-box">
						<input class="prompt" type="text" id="search" placeholder="search">
						<select id="searchby-dropdown" class="ui dropdown nw-search-by-dropdown label">
							<option value="0">Search By</option>
						</select>
					</div>
					<div class="results"></div>
				</div> 
			</div>
			<p>{{{json data.links}}}</p>
			<div id="chart" visdata='{{{json data}}}' class="network canvas draw fullwidth">
			</div>
			
		</div>
	</div>
	{{!--
	<script src="https://cdnjs.cloudflare.com/ajax/libs/d3/5.7.0/d3.min.js"></script> --}}
	<script src="https://fastcdn.org/D3.js/3.5.6/d3.min.js"></script>
