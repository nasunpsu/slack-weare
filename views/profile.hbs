      <div class="ten wide field">
        <label for="">Current military status</label>
        <select class="ui dropdown military" name="military" id="military" class="military">
          <option value="ad">Active Duty</option>
          <option value="re">Reserves</option>
          <option value="ng">National Guard</option>
          <option value="vt">Veteran (No reserve service obligation remaining, individual Ready Reserve)</option>
          <option value="fm">Family member/dependent of a member of the U.S. Armed Forces or Veteran</option>
          <option value="none">None of the above</option>
        </select>
      </div>
    </div>
    <div class="fields personal-info-edit facts">
      <div class="eight wide field">
        <label for="">Career Goals</label>
        <textarea name="career" id="fun" cols="30" rows="5" placeholder="Any future career you'd like to have or goals you have within your current career." >{{userInfo.fun}}</textarea>
      </div>
      <div class="eight wide field">
        <label for="">Past Careers</label>
        <textarea id="unique" name="unique" cols="30" rows="5" placeholder="Companies and jobs you've worked in previously." >{{userInfo.unique}}</textarea>
      </div>
    </div>
    
    <h4 class="ui horizontal divider header">
      Personal Info
    </h4>
    <div class="fields personal-info-edit places">
      <div class="eight wide field">
        <label>Places I've Lived</label>

        <input type="text" name="past-cities" placeholder="Your city. E.g. State College, PA" value="{{userInfo.city}}">

      </div>
      <div class="eight wide field">
        <label>Places I'd Like to Visit</label>
        <input type="text" name="places" placeholder="E.g. Paris, France" value="{{userInfo.likeplaces}}">
      </div>
    </div>
    <div class="fields personal-info-edit family">

      <div class="eight wide field">
        <label>Marital Status</label>
        <input type="text" name="marital" placeholder="E.g. married" value="{{userInfo.married}}">
      </div>
      <div class="eight wide field">
        <label>Number of Kids</label>
        <input type="text" name="kids" placeholder="E.g. 3" value="{{userInfo.kids}}">
      </div>
    </div>
    <div class="fields personal-info-edit facts">
      <div class="eight wide field">
        <label for="">Fun fact</label>
        <textarea name="fun" id="fun" cols="30" rows="5" placeholder="E.g. My father graduated from PSU 20 years ago." >{{userInfo.fun}}</textarea>
      </div>
      <div class="eight wide field">
        <label for="">Things my peers should know about me</label>
        <textarea id="unique" name="unique" cols="30" rows="5" placeholder="E.g. I served in the military for 10 years, and I care a lot about punctuality." >{{userInfo.unique}}</textarea>
      </div>
    </div>
    <div id="submit-button" class="ui submit button save-profile-changes">Save Changes</div>
    <div class="ui error message"></div>
  </form>
</section>