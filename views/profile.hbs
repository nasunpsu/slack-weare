<section class="profile-edit-wrapper">
  <div class="ui message info">
        <div class="header">
            To edit your profile, change any of the below information, and be sure to click save changes at the bottom of this page.
        </div>
        {{!-- <ul class="list">
            <li>Click the green button below to schedule a meeting with your peers.</li>
            <li>Or Use /we-discuss in Slach channels and select Later to schedule a meeting.</li>
        </ul> --}}
    </div>
