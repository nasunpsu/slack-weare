    <div class="profile-img-wrapper">
      <img class="ui small right floated image profile-img" src={{userInfo.image_512}}>
    </div>
    <div class="fields basic-info-edit">
      <div class="six wide field">
        <label>Full Name</label>
        <input type="text" name="fullname" placeholder="Your name as you would like it to appear on your profile."
          value="{{userInfo.real_name}}">
      </div>
      <div class="six wide field">
        <label>City, Province I live in</label>
        <input type="text" name="city" placeholder="E.g. Pittsburgh, PA"
          value="{{#if userInfo.city}}{{userInfo.city}}, {{userInfo.province}}{{/if}}">
      </div>
      <div class="two wide field">
        <label for=""> Gender</label>
        <select class="ui dropdown gender" type="text" placeholder="Gender" value="{{userInfo.gender}}">
          <option value="female" class="value">Male</option>
          <option value="male" class="value">Female</option>
          <option value="other" class="value">Other</option>
        </select>
      </div>

    </div>
