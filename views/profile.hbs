      <div class="six wide field">
        <label>Email</label>
        <input type="email" name="email" placeholder="An email peers can contact you with."
          value="">
      </div>
    </div>
    <div id="available" class="availability basic-info-edit inline fields">
          <div class="field centered middle aligned">
            <label> I am </label>
            <select class="ui dropdown" name="availability">
              <option value="available">available online</option>
              <option value="unavailable">unavailable online</option>
            </select>
          </div>
            
          {{!-- <div class="ui label blue basic available">I am available online on</div> --}}
        
      <div class="field centered middle aligned">
        <label> on </label>
        <select class="ui dropdown weekday" name="weekday">
          <option value="sun">Sunday</option>
          <option value="mon">Monday</option>
          <option value="tue">Tuesday</option>
          <option value="wed">Wednesday</option>
          <option value="thur">Thursday</option>
          <option value="fri">Friday</option>
          <option value="sat">Saturday</option>
        </select>
      </div>
      <div class="field" style="display: flex;">
        <label style="align-items: center;display:flex;"> from </label>
        <div class="ui calendar week-day" id="pop-time">
          <div class="ui input weekday-time left icon">
            <i class="time icon"></i>
            <input type="text" name="start" placeholder="Start time" value="{{userInfo.Avail.start_time}}">
          </div>
        </div>
        <label style="margin-left: 15px; margin-right: 10px; align-items: center;display:flex;"> till </label>

      </div>
      <div class="field">
        <div class="ui calendar week-day" id="pop-time">
          <div class="ui input weekday-timeleft icon">
            <i class="time icon"></i>
            <input type="text" name="to" placeholder="End time" value="{{userInfo.Avail.end_time}}">
          </div>
        </div>
      </div>
      <div class="field">
        <div class="ui buttons">
          <div onClick= "removeTime(this)" class="ui basic button delete-button"><i class="icon trash"></i></div>
          <div onClick="addTime()" class="ui basic button add-button"><i class="icon green plus"></i></div>
        </div>
      </div>
    </div>
    <h4 class="ui horizontal divider header">
      Educational Info
    </h4>
    <div class="fields instrumental-info courses">
      <div class="field error">
        <label>Major</label>
        <div class="field">
          <input type="text" name="major" placeholder="{{userInfo.major}} {{userInfo.title}}">
        </div>
      </div>
      <div class="field">
        <label>Penn State Campus</label>
        <div class="field">
          <input type="text" name="campus" placeholder="{{userInfo.campus}}">
        </div>
      </div>
      <div class="nine wide field">
        <label>Current Courses</label>
        <input type="text" name="courses" placeholder="e.g. IST 110;" value="{{userInfo.courses}}">
      </div>
    </div>
    <div class="basic-info-edit field">
      <label>What I want to gain from World Campus</label>
      <textarea name="goals" id="" cols="30" rows="5" placeholder="Anything you would like to gain from this experience (academic or not).">{{userInfo.goals}}</textarea>
    </div>
    <div class="two inline recommendation fields">
      <div class="nine wide field">
        <label>Courses I Recommend</label>
        <input type="text" name="recommended-courses" placeholder="e.g. IST 110;" value="{{userInfo.reccourses}}">
      </div>
      <div class="seven wide field">
        <label>Instructors I Recommend</label>
        <input type="text" name="recommended-instructor" placeholder="e.g. InstructorName;" value=""
          {{userInfo.instructors}}>
      </div>
    </div>
    
