<div class="meetings-wrapper">
    {{#if (eq meetings.length 0)}}
    <div class="ui message info">
        <i class="close icon"></i>
        <div class="header">
            You have not created or been invited to any meetings.
        </div>
        <ul class="list">
            <li>Click the green button below to schedule a meeting with your peers.</li>
            <li>Or Use /we-discuss in Slack channels and select Later to schedule a meeting.</li>
        </ul>
    </div>

    {{else}}
    <div class="ui message info">
        <i class="close icon"></i>
        <div class="header">
            You have created or been invited to the following meetings.
        </div>
        <ul class="list">
            <li>Click the green button below to schedule a meeting with your peers.</li>
            <li>Or Use /we-discuss in Slack channels and select Later to schedule a meeting.</li>
        </ul>
    </div>
    {{!-- <p>{{{json userInfo}}}</p> --}}
    <div class="ui success message update-attendees invisible">
      <i class="close icon"></i>
      <div class="header">
        You have successfully reminded/invited your peers.
      </div>
      <ul class="list">
        <li><b>Invite</b> goes to all guests who are invited but have not responded.</li>
        <li><b>Remind</b> goes to all guests who confirmed to attend to update the meeting or remind the approaching time.</li>
      </ul>
    </div>
    <table class="ui sortable table ascending celled list-table">
        <thead>
            <tr id="table-head" class="center aligned">
                <th scope="col" class="two wide">Meeting Purpose</th>
                <th scope="col" class="three wide">Date & Time</th>
                <th scope="col" class="one wide">Topic</th>
                <th scope="col" class="one wide">Organizer</th>
                <th scope="col" class="six wide">Guests</th>
                <th scope="col" class="three wide">Action</th>
            </tr>
        </thead>
        <tbody id="table-body">
            {{#each meetings as |meeting|}}
            <tr class="center aligned">
                <td>
                    <a href="/meeting/{{this.mid}}" data-toggle="modal"
                        data-target=".meeting-modal">{{this.purpose}}</a>
                </td>
                <td> {{meeting.date}} {{meeting.start_time}}</td>
                <td> {{meeting.topic}}</td>
                <td>{{meeting.creator_name}}</td>
                <td> {{#each meeting.attendees as |attendee|}} 
                    {{#unless (eq attendee.uid meeting.creator_uid)}}
                    {{attendee.real_name}} 
                    {{#if (eq attendee.attend "accept")}}<i class="check attendance-status icon"></i>
                    {{else if (eq attendee.attend "reject")}}<i class="close attendance-status icon"></i>
                    {{else}}<i class="question circle outline attendance-status icon"></i>{{/if}};
                    {{/unless}}
                    {{/each}}</td>
                <td>
                    {{!-- |creator is {{meeting.creator_uid}}|uid is {{../userInfo.uid}} --}}
                    {{#if (eq meeting.creator_uid ../userInfo.uid)}}
                    <div class="ui basic meeting blue edit button"> <i class="pencil icon"></i><a class="edit"
                            href="/meeting/{{meeting.mid}}">Edit</a> </div>
                    <div class="ui basic meeting yellow remind button" data-content="Remind your confirmed guests via Slack DM"  data-position="bottom center" data-mid="{{meeting.mid}}" data-purpose="{{meeting.purpose}}" data-date="{{meeting.date}}" data-time="{{meeting.start_time}}" data-creator="{{meeting.creator_name}}" data-attendees='{{{json meeting.attendees}}}'> <i class="bell outline icon"></i>Remind</div>
                    <div class="ui basic meeting green invite button" data-content="Invite guests who have not responded"  data-position="bottom center" data-mid="{{meeting.mid}}" data-purpose="{{meeting.purpose}}" data-date="{{meeting.date}}" data-time="{{meeting.start_time}}" data-creator="{{meeting.creator_name}}" data-attendees='{{{json meeting.attendees}}}'> <i class="paper plane outline icon"></i>Invite</div>
                    {{else}}
                    <div class="ui buttons">
                        {{#each meeting.attendees as |attendee|}} 
                        {{#if (eq attendee.uid ../../userInfo.uid)}}
                        <div class="ui {{#unless (eq attendee.attend "reject")}}basic{{/unless}} meeting red button reject" data-attendees='{{{json meeting.attendees}}}' data-mid="{{meeting.mid}}" data-react="reject">
                            <i class="times icon"></i>Reject
                        </div>
                        <div class="or"></div>
                        <div class="ui {{#unless (eq attendee.attend "accept")}}basic{{/unless}} meeting teal button accept" data-attendees='{{{json meeting.attendees}}}' data-mid="{{meeting.mid}}" data-react="accept">
                            <i class="check icon"></i>Accept
                        </div>
                        {{/if}}
                        {{/each}}
                        {{!-- <div class="ui basic meeting red button reject" data-attendees='{{{json meeting.attendees}}}' data-mid="{{meeting.mid}}" data-react="reject">
                            <i class="times icon"></i>Reject
                        </div>
                        <div class="or"></div>
                        <div class="ui basic meeting teal button accept" data-attendees='{{{json meeting.attendees}}}' data-mid="{{meeting.mid}}" data-react="accept">
                            <i class="check icon"></i>Accept
                        </div> --}}
                    </div>

                    {{/if}}
                </td>
            </tr>
            {{/each}}
        </tbody>
    </table>
    
    <h5>*Note that <i class="attendance-status icon question outline circle"></i>  means the attendee has not responded to the invitations; <i class="attendance-status icon close"></i> means the attendee cannot attend to the scheduled meeting; <i class="attendance-status icon check"></i> means the attendee accepted this invitation.</h5>
    {{/if}}
    <div id="new" class="ui create meeting right floated teal button">New Meeting</div>
</div>
