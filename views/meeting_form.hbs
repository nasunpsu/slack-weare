<div class="meeting-wrapper">
    {{#if meeting.exist}}
    {{!-- <h5>{{{json userInfo.uid}}}</h5>
    <h5>{{{json meeting.creator_uid}}}</h5> --}}
    {{#unless (eq meeting.creator_uid userInfo.uid)}}
    <div class="ui info attached message">
        <i class="close icon"></i>
        <div class="header">
            You have been invited to this meeting.
        </div>
        <ul class="list">
            <li>Contact the creator of the meeting for questions or revision suggestions.</li>
            <li>Respond with Accept or Reject to show your attendence.</li>
        </ul>
    </div>
    {{/unless}}
    <form
        class="ui form attached fluid {{#unless (eq meeting.creator_uid userInfo.uid)}}segment{{/unless}} meeting-form" data-mid="{{meeting.mid}}" data-cid="{{meeting.cid}}" data-cname="{{meeting.cname}}"
        id="meeting-form" method="POST">
        {{#unless (eq meeting.creator_uid userInfo.uid)}}<fieldset disabled="disabled">{{/unless}}
            {{!-- action="/meeting/{{meeting.mid}}" --}}
            <div class="ui error message"></div>
            <div class="ui success message">
                <i class="close icon"></i>
                <div class="header">
                    Update success.
                </div>
                {{!-- <p>Check your <a href="/meetings" target="_blank" rel="noopener noreferrer">meeting list</a>.</p> --}}
            </div>
            <h3>Meeting Agenda</h3>
            <div class="fields meeting agenda">
                <div class="ten wide field">
                    <label>Purpose</label>
                    <input type="text" name="purpose" id="purpose" placeholder="e.g. Talk about group project (due 2.1)"
                        value="{{{unescape meeting.purpose}}}">
                </div>
                <div class="six wide field">
                    <label>Topic</label>
                    <select class="ui fluid dropdown select-topic" name="topic" id="topic">
                        <option value="materials">Course materials</option>
                        <option value="homework">Homework discussion (Q&A)</option>
                        <option value="sync">Group sync</option>
                        <option value="other">Other</option>
                    </select>
                    <input type="text" id="hidden-topic" placeholder="Topic" value="{{meeting.topic}}"
                        style="display: None">
                </div>
            </div>

            <div class="fields">
                <div class="sixteen wide field">
                    <label>Description</label>
                    <textarea id="description" name="description" cols="40" rows="5"
                        placeholder="e.g. We will set up a plan and timeline for individuals' share of work, available time to work together and also talk about one another's situation for possible unavailable meetings.">{{{unescape meeting.description}}}</textarea>
                </div>
            </div>
            <h3>When</h3>
            <div class="fields when meeting">
                <div class="four wide field">
                    <label><i class="calendar alternate outline icon"></i>Date</label>
                    {{!-- <input type="text" placeholder="YY:MM:DD"> --}}
                    <div class="ui calendar" id="pop-date">
                        <div class="ui input left icon">
                            <i class="calendar icon"></i>
                            <input type="text" id="date" name="date" placeholder="Date" value="{{meeting.date}}">
                        </div>
                    </div>
                </div>
                <div class="two wide field">
                    <label><i class="clock outline icon"></i>Time</label>
                    <div class="ui calendar" id="pop-time">
                        <div class="ui input left icon">
                            <i class="time icon"></i>
                            <input type="text" id="time" name="time" placeholder="Time" value="{{meeting.time}}">
                        </div>
                    </div>
                </div>
                <div class="two wide field">
                    <label><i class="hourglass icon"></i>Duration</label>
                    <label
                        style="display:flex; flex-direction: row; justify-content: center; align-items: center"><input
                            type="text" id="duration" name="duration" value="{{meeting.duration}}"> <span>minutes</span>
                    </label>
                </div>
                <div class="five wide field">
                    <label><i class="globe icon"></i>Timezone Offset</label>
                    <div class="ui basic label" data-tooltip='Look at the Connect -> Timezones to check your temporal distance.' style="max-width: 5em; height: 34.63px; display:flex; flex-direction: row; justify-content: center; align-items: center">{{meeting.tz}}</div>
                </div>
            </div>
            <h3>Attendees</h3>
            {{!-- <p>{{{json meeting}}}</p> --}}
            <div class="fields attendees meeting">
                <div class="four wide field">
                    <label>Scope</label>
                    <select class="ui fluid dropdown select-scope" id="who" name="who">
                        <option value="all">All members of the channel</option>
                        <option value="custom">Specify individuals</option>
                    </select>
                </div>
                <div class="twelve wide field">
                    <label>Specify</label>
                    <select class="ui fluid search dropdown select-attendee" id="select-attendees" name="attendees"
                        multiple="">
                        {{!-- {{#unless (eq meeting.who "all")}}<option value="all">All members from #{{meeting.cname}}</option> --}}
                        {{!-- {{/unless}} --}}
                        {{#each meeting.cmembers}}<option value="{{this.uid}}">{{this.real_name}}</option> {{/each}}
                    </select>
                    {{!-- <input type="text" id="attendees" placeholder="separated by; E.g. Jenny Hollan; Joe Doe;"
                    value="{{#each meeting.attendees}} {{this.uid}}; {{/each}}" style="display: none"> --}}
                </div>
            </div>
            <h4>*Note that you can only choose attendees from the same channel #{{meeting.cname}}.</h4>
            <div id="save"
                class="ui meeting right floated teal button {{#unless (eq meeting.creator_uid userInfo.uid)}}invisible{{/unless}}">
                Save</div>
            {{!-- <div id="invite"
                class="ui invite meeting right floated yellow button {{#unless (eq meeting.creator_uid userInfo.uid)}}invisible{{/unless}}">
                Save and Invite</div> --}}
            <div id="delete"
                class="ui invite meeting right floated red basic button {{#unless (eq meeting.creator_uid userInfo.uid)}}invisible{{/unless}}">
                Delete</div>
            {{#unless (eq meeting.creator_uid userInfo.uid)}}
        </fieldset>
        {{/unless}}
        <div class="ui buttons meeting-form {{#if (eq meeting.creator_uid userInfo.uid)}}invisible{{/if}}">
            <div id="reject" class="ui basic meeting red button reject">
                <i class="times icon"></i>Reject
                {{!-- <a class="reject" href="#"></a> --}}
            </div>
            <div class="or"></div>
            <div id="accept" class="ui basic meeting teal button accept">
                <i class="check icon"></i><a class="accept" href="#">Accept</a>
            </div>
        </div>

    </form>
    {{else}}
    <div class="ui message warning">
        <h3><i class="exclamation triangle icon"></i>Unknown meeting url - please check your meeting URL in the browser
            or start over the /we-discuss again!</h3>
    </div>

    {{/if}}
</div>
<div id="data_string" placeholder="Topic" data='{{{unescape (json meeting)}}}' style="display: None"></div>