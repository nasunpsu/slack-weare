<div class="meeting-wrapper">
    {{#if meeting.exist}}
    {{!-- <h5>{{{json userInfo.uid}}}</h5>
    <h5>{{{json meeting.creator_uid}}}</h5> --}}
    {{#unless (eq meeting.creator_uid userInfo.uid)}}
    <div class="ui info attached message">
        <i class="close icon"></i>
        <div class="header">
            You have been invited to this meeting.
        </div>
        <ul class="list">
            <li>Contact the creator of the meeting for questions or revision suggestions.</li>
            <li>Respond with Accept or Reject to show your attendence.</li>
        </ul>
    </div>
    {{/unless}}
    <form
        class="ui form attached fluid {{#unless (eq meeting.creator_uid userInfo.uid)}}segment{{/unless}} meeting-form" data-mid="{{meeting.mid}}" data-cid="{{meeting.cid}}" data-cname="{{meeting.cname}}"
        id="meeting-form" method="POST">
        {{#unless (eq meeting.creator_uid userInfo.uid)}}<fieldset disabled="disabled">{{/unless}}
            {{!-- action="/meeting/{{meeting.mid}}" --}}
            <div class="ui error message"></div>
            <div class="ui success message">
                <i class="close icon"></i>
                <div class="header">
                    Update success.
                </div>
                {{!-- <p>Check your <a href="/meetings" target="_blank" rel="noopener noreferrer">meeting list</a>.</p> --}}
            </div>
            <h3>Meeting Agenda</h3>
            <div class="fields meeting agenda">
                <div class="ten wide field">
                    <label>Purpose</label>
                    <input type="text" name="purpose" id="purpose" placeholder="e.g. Talk about group project (due 2.1)"
                        value="{{meeting.purpose}}">
                </div>
                <div class="six wide field">
                    <label>Topic</label>
                    <select class="ui fluid dropdown select-topic" name="topic" id="topic">
                        <option value="materials">Course materials</option>
                        <option value="homework">Homework discussion (Q&A)</option>
                        <option value="sync">Group sync</option>
                        <option value="other">Other</option>
                    </select>
                    <input type="text" id="hidden-topic" placeholder="Topic" value="{{meeting.topic}}"
                        style="display: None">
                </div>
            </div>

            <div class="fields">
                <div class="sixteen wide field">
                    <label>Description</label>
                    <textarea id="description" name="description" cols="40" rows="5"
                        placeholder="e.g. We will set up a plan and timeline for individuals' share of work, available time to work together and also talk about one another's situation for possible unavailable meetings.">{{meeting.description}}</textarea>
                </div>
            </div>
            <h3>When</h3>
            <div class="fields when meeting">
                <div class="four wide field">
                    <label><i class="calendar alternate outline icon"></i>Date</label>
                    {{!-- <input type="text" placeholder="YY:MM:DD"> --}}
                    <div class="ui calendar" id="pop-date">
                        <div class="ui input left icon">
                            <i class="calendar icon"></i>
                            <input type="text" id="date" name="date" placeholder="Date" value="{{meeting.date}}">
                        </div>
                    </div>
                </div>
                <div class="two wide field">
                    <label><i class="clock outline icon"></i>Time</label>
                    <div class="ui calendar" id="pop-time">
                        <div class="ui input left icon">
                            <i class="time icon"></i>
                            <input type="text" id="time" name="time" placeholder="Time" value="{{meeting.time}}">
                        </div>
                    </div>
                </div>
                <div class="two wide field">
                    <label><i class="hourglass icon"></i>Duration</label>
                    <label
                        style="display:flex; flex-direction: row; justify-content: center; align-items: center"><input
                            type="text" id="duration" name="duration" value="{{meeting.duration}}"> <span>minutes</span>
                    </label>
                </div>
                <div class="five wide field">
                    <label><i class="globe icon"></i>Timezone</label>
                    <select name='tz-selection' class="ui fluid normal search dropdown">
                        <option timeZoneId="1" gmtAdjustment="GMT-12:00" useDaylightTime="0" value="-12">(GMT-12:00)
                            International
                            Date Line West</option>
                        <option timeZoneId="2" gmtAdjustment="GMT-11:00" useDaylightTime="0" value="-11">(GMT-11:00)
                            Midway
                            Island,
                            Samoa</option>
