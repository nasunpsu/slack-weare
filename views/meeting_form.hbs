            <h3>Attendees</h3>
            {{!-- <p>{{{json meeting}}}</p> --}}
            <div class="fields attendees meeting">
                <div class="four wide field">
                    <label>Scope</label>
                    <select class="ui fluid dropdown select-scope" id="who" name="who">
                        <option value="all">All members of the channel</option>
                        <option value="custom">Specify individuals</option>
                    </select>
                </div>
                <div class="twelve wide field">
                    <label>Specify</label>
                    <select class="ui fluid search dropdown select-attendee" id="select-attendees" name="attendees"
                        multiple="">
                        {{!-- {{#unless (eq meeting.who "all")}}<option value="all">All members from #{{meeting.cname}}</option> --}}
                        {{!-- {{/unless}} --}}
                        {{#each meeting.cmembers}}<option value="{{this.uid}}">{{this.real_name}}</option> {{/each}}
                    </select>
                    {{!-- <input type="text" id="attendees" placeholder="separated by; E.g. Jenny Hollan; Joe Doe;"
                    value="{{#each meeting.attendees}} {{this.uid}}; {{/each}}" style="display: none"> --}}
                </div>
            </div>
            <h4>*Note that you can only choose attendees from the same channel #{{meeting.cname}}.</h4>
            <div id="save"
                class="ui meeting right floated teal button {{#unless (eq meeting.creator_uid userInfo.uid)}}invisible{{/unless}}">
                Save</div>
            <div id="invite"
                class="ui invite meeting right floated yellow button {{#unless (eq meeting.creator_uid userInfo.uid)}}invisible{{/unless}}">
                Save and Invite</div>
            <div id="delete"
                class="ui invite meeting right floated red basic button {{#unless (eq meeting.creator_uid userInfo.uid)}}invisible{{/unless}}">
                Delete</div>



            <input type="text" id="invite_label" name="invite" value="false" style="display: None">


            {{#unless (eq meeting.creator_uid userInfo.uid)}}
        </fieldset>
        {{/unless}}
        <div class="ui buttons meeting-form {{#if (eq meeting.creator_uid userInfo.uid)}}invisible{{/if}}">
            <div id="reject" class="ui basic meeting red button reject">
                <i class="times icon"></i>Reject
                {{!-- <a class="reject" href="#"></a> --}}
            </div>
            <div class="or"></div>
            <div id="accept" class="ui basic meeting teal button accept">
                <i class="check icon"></i><a class="accept" href="#">Accept</a>
            </div>
        </div>

    </form>
    {{else}}
    <div class="ui message warning">
