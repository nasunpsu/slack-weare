
<link rel="stylesheet" href="https://stackpath.bootstrapcdn.com/bootstrap/4.2.1/css/bootstrap.min.css" integrity="sha384-GJzZqFGwb1QTTN6wy59ffF1BuGJpLSa9DkKMp0DgiMDm4iYMj70gZWKYbI706tWS"
    crossorigin="anonymous">
<script src="https://cdnjs.cloudflare.com/ajax/libs/popper.js/1.14.6/umd/popper.min.js" integrity="sha384-wHAiFfRlMFy6i5SRaxvfOCifBUQy1xHdJ/yoi7FRNXMRBu5WHdZYu1hA6ZOblgut"
    crossorigin="anonymous"></script>
<script src="https://stackpath.bootstrapcdn.com/bootstrap/4.2.1/js/bootstrap.min.js" integrity="sha384-B0UglyR+jN6CkvvICOB2joaf5I4l3gm9GU6Hc1og6Ls7i6U/mkkaduKaBhlAXv9k"
    crossorigin="anonymous"></script>
<link rel="stylesheet" type="text/css" href="/stylesheets/connect.css">
<script src="https://rawgit.com/farzher/fuzzysort/master/fuzzysort.js"></script>
<script src="https://semantic-ui.com/javascript/library/tablesort.js"></script>
<script>
    [window.sessionUser, window.tableUsers] = (() => {
        const [userString, tableString] = [`{{user}}`, `{{usersString}}`];
        const text = document.createElement('textarea');
        text.innerHTML = userString;
        const user = JSON.parse(text.value);
        text.innerHTML = tableString;
        const table = JSON.parse(text.value);
        return [user, table];
    })();
</script>
<script src="/js/table.js"></script>
<div style="margin-top: 60px;">
    <main class="connect-wrapper">
        <div class="filter-wrapper">
            <h3>Connect with Peers Like You</h3>
            <div class="filters">
                <p>View peers who share your</p>
                <form id="checkboxes">
                    <div class="ui checkbox">
                        <input type="checkbox" id="locationCheck">
                        <label class="form-check-label" for="locationCheck"><a class="ui red empty circular label mini"></a> Location</label>
                    </div>
                    <div class="ui checkbox">
                        <input type="checkbox" id="majorCheck">
                        <label for="majorCheck"><a class="ui orange empty circular label mini"></a> Major</label>
                    </div>
                    <!--
                    <div class="ui checkbox">
                        <input type="checkbox" id="industryCheck">
                        <label for="industryCheck">Profession</label>
                    </div>
                    <div class="ui checkbox">
                        <input type="checkbox" id="militaryCheck">
                        <label for="militaryCheck">Military Background</label>
                    </div>
                    <div class="ui checkbox">
                        <input type="checkbox" id="parentalCheck">
                        <label for="parentalCheck">Parental Status</label>
                    </div>
                    <div class="ui checkbox">
                        <input type="checkbox" id="industryCheck">
                        <label for="pastClassCheck">Past Classes</label>
                    </div>
                    -->
                </form>
            </div>
            <div class="ui category search search-table">
                <div class="ui icon right labeled input search-box">
                    <input class="prompt" type="text" id="search" placeholder="search">
                    <select id="dropdown" class="ui dropdown sort-dropdown label">
                        <option value="0">All Fields</option>
                    </select>
                </div>
                <div class="results"></div>
                
                <select id="sortDropdown" class="ui dropdown sort-dropdown">
                    <option value="0">Similarity</option>
                </select>
            </div> 
            <p style="padding-top: 20px">Note: Colored text indicates that you share the item in color.</p>
        </div>
        <table class="ui sortable table ascending celled list-table">
            <thead>
                <tr id="table-head">
                    <th scope="col">Name</th>
                    <th scope="col">Major</th>
                    <th scope="col">Location</th>
                    <th scope="col">Channels</th>
                </tr>
            </thead>
            <tbody id="table-body">
                {{#each users}}
                    <tr style="display: none">
                        <td>
                            <a href="#" data-toggle="modal" data-target=".profile-modal">{{this.real_name}}</a>
                        </td>
                        <td {{#if this.ismajorShared}}style="color: #f2711c"{{/if}}>{{this.major}}</td>
                        <td {{#if this.islocal_areaShared}}style="color: #db2828"{{/if}}>{{this.local_area}}</td>
                        <td>
                            {{#each this.displayChannels}}
                                <span {{#if this.isShared}}class="{{this.className}}"{{/if}}>{{this.name}};  </span>
                            {{/each}}
                            {{#if this.extraChannels.length }}
                                <div class="ui accordion">
                                    <div class="title">
                                        <i class="dropdown icon"></i>
                                        Show More
                                    </div>
                                    <div class="content">
                                        <p class="transition hidden">
                                            {{#each this.extraChannels}}
                                                <span {{#if this.isShared}}class="{{this.className}}"{{/if}}>{{this.name}};  </span>
                                            {{/each}}
                                        </p>
                                    </div>
                                </div>
                            {{/if}}
                        </td>
                    </tr>
                {{/each}}
            </tbody>
        </table>
        <div aria-label="Pagination Navigation" id="page-container" role="navigation" class="ui pagination menu">
            <a aria-current="false" id="previousPage" aria-disabled="false" tabindex="0" value="1" aria-label="Previous item" type="prevItem" class="item">⟨</a>
            <a aria-current="true" aria-disabled="false" tabindex="0" value="1" type="pageItem" class="page-number active item">1</a>
            <a aria-current="false" aria-disabled="false" tabindex="0" value="2" type="pageItem" class="page-number item">2</a>
            <a aria-current="false" aria-disabled="false" tabindex="0" value="3" type="pageItem" class="page-number item">3</a>
            <a aria-current="false" aria-disabled="false" id="nextPage" tabindex="0" value="2" aria-label="Next item" type="nextItem" class="item">⟩</a>
        </div>
    </main>
</div>