<main class="dashboard-wrapper">
    <h1 class="dashboard-title">We Are! Connecting you to your&nbsp;peers.</h1>
    <h2 class="ui black header personal-title">
        <div class="content">WeAre! Slack Stats</div>
    </h2>
    <div class="slack-stats">
        <div class="ui statistics team-meta">
            <div class="statistic yellow">
                <div class="value">
                    <i class="slack hash small icon"></i>{{channels_info.channels_total}} / {{total_channels_num}}
                </div>
                <div class="label">
                    Subscribed / Total Channels
                </div>
            </div>
            <div class="statistic olive">
                <div class="value">
                    <i class="users small icon"></i> {{members.members_total}}
                </div>
                <div class="label">
                    {{!-- Interacted / Total Members --}}
                    Total Members
                </div>
            </div>
            <div class="statistic green">
                <div class="value">
                    <i class="comments small icon"></i>{{msgs_total}}
                </div>
                <div class="label">
                    Messages
                </div>
            </div>
        </div>
    </div>
    <h2 class="ui black header personal-title">
        <div class="content">Personal Slack Stats</div>
    </h2>
    <div class="slack-stats personal-stats">
        <div class="ui statistics team-meta">
            <div class="statistic teal personal-stat">
                <div class="value">
                    <i class="paw small icon"></i>&nbsp;{{channels_info.channels_total}} / {{total_channels_num}}
                </div>
                <div class="label">
                    WeAre!'s Given / Received
                </div>
            </div>
            <div class="statistic blue personal-stat">
                <div class="value">
                    <i class="thumbs up outline small icon"></i>&nbsp;{{msgs_total}}
                </div>
                <div class="label">
                    Reactions Given / Received
                </div>
            </div>
            <div class="statistic violet personal-stat">
                <div class="value">
                    <i class="thumbs up outline small icon"></i>&nbsp;{{msgs_total}}
                </div>
                <div class="label">
                    Messages Sent / Received
                </div>
            </div>
        </div>
    </div>
    <h2 class="ui blue header post-title">
        <div class="content">Most Reacted Messages From Your Subscribed Channels</div>
        <div class="ui right floated blue button" id="refresh-msgs">Refresh messages</div>
    </h2>
    <div class="post-wrapper">
        {{#each msgs as |msg|}}
        <div class="ui card message-card">
            <div class="message medium ui basic label">
                {{msg.text}}
                {{#if msg.hasExtra}}
                <span class="hideable" style="display: none">
                    {{msg.extraText}}
                </span>
                <div>
                    <a href="#/" onclick="showHide(this)">show more</a>
                </div>
                {{/if}}
            </div>
            <div class="ui basic label react-emoji-count">
                {{#each msg.reactions as |react|}} 
                :{{react.name}}: <span class="ui blue left pointing mini label emoji-label">{{react.count}}</span>
                {{/each}}
            </div>
            <div class="post-img-wrapper">
                <img class="ui small right floated image profile-img" src=>
            </div>
            <div class="extra content">
                <div class="header"><a href="https://slack.com/app_redirect?channel={{msg.cname}}"
                            target="_blank"><i class="slack hash small icon"></i>{{msg.cname}}</a></div>
                <div class="meta">
                    <span class="left floated time">{{{timeConverter msg.ts ../userInfo}}}</span>
                </div>
                <div class="right floated author">
                    <div class="user-dm">
                        <a href="slack://user?team={{{get_TeamID msg.cid}}}&amp;id={{msg.uid}}" data-tooltip="Click here to message me via Slack Desktop!"><img class="ui avatar image" src="{{msg.user_avatar}}"> {{msg.username}}</a>
                    </div>
                </div>
            </div>
        </div>
        {{/each}}
    </div>
    <h2 class="channel-title ui blue header">Most Active Channels You're Subscribed to</h2>
    <div class="channel-wrapper">
        <table id="home-table" class="ui sortable celled table table-striped table-dark channel-table">
            <thead>
                <tr>
                    <th scope="col">CHANNEL</th>
                    <th scope="col"># OF MEMBERS</th>
                    <th scope="col"># OF MESSAGES</th>
                    <th scope="col">MOST RECENT MESSAGE</th>
                </tr>
            </thead>
            <tbody>
                {{#each channels_info.TopActiveChannels as |channel|}}
                <tr class="center aligned">
                    <td><a href="https://slack.com/app_redirect?channel={{channel.cname}}"
                            target="_blank" class="slack-link">#{{channel.cname}}</a></td>
                    <td>{{channel.num_members}}</td>
                    <td>{{channel.num_msgs}}</td>
                    <td>{{{timeConverter channel.latest_msg_ts ../userInfo}}}</td>
                </tr>
                {{/each}}

            </tbody>
        </table>
    </div>
</main>
