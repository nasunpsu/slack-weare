{{#with user}}
<div class="profile-header">
  <div class="profile-img-wrapper">
    <img class="ui small image profile-img" src="{{image_512}}">
  </div>

  <div class="profile-name">
    <h2>{{real_name}}
      {{#if (eq gender 'female')}}<i class="ui female icon" style="opacity: .5; font-size: 70%"></i>
      {{else if (eq gender 'male')}}<i class="ui female icon" style="opacity: .5; font-size: 70%"></i>
      {{/if}}
    </h2>
    <div class="header-info">
      <div class="ui list">
        <div class="item">
          <br>
          <p><i class="ui map marker alternate icon" style="opacity: .75;"></i> {{city}}</p>
        </div>
      </div>
      <div class="ui list">
        <div class="item">
          <br>
          <p><i class="ui globe icon" style="opacity: .75;"></i> {{tz_label}}</p>
        </div>
      </div>
      <div class="ui list">
        <div class="item">
          <br><a href="mailto:{{email}}"><i class="ui envelope icon" style="opacity: .75;"></i> {{email}} </a>
        </div>
      </div>
    </div>
    {{!-- <h5 style="margin-bottom: 0px; margin-top: 0px; font-weight: 100;">Similarities</h5> --}}
    <div class="ui yellow small label">Similarity is marked in yellow</div>

  </div>
  {{#if (eq uid ../userInfo.uid)}}
  <button class="ui right floated white labeled icon button edit-profile">
    <i class="pencil icon"></i>
    <a href="/editProfile">Edit</a>
  </button>
  {{/if}}
  <button class="ui right floated green labeled icon button user-dm">
    <i class="slack hash icon"></i>
    <a class="slackme" href="slack://user?team={{team_id}}&amp;id={{{get_UserID uid}}}">Message me on Slack!</a>
  </button>

</div>
</div>
<section class="profile-wrapper">
  <div class="basic-info">
    <div class="ui top attached big label">Availability</div>
    <div class="basic-info-text">
      <div class="ui list">
        <div class="large item">
          <div class="ui green small horizontal label">Available Times</div>
          {{#each availability as |a|}}
          {{#if (eq a.available "available")}}<br>
          <p>{{a.weekday}}: {{a.start}} - {{a.to}}</p>{{/if}}
          {{/each}}
        </div>
      </div>
      <div class="ui list">
        <div class="large item">
          <div class="ui red small horizontal label">Unavailable Times</div>
          {{#each availability as |a|}}
          {{#if (eq a.available "unavailable")}}<br>
          <p>{{a.weekday}}: {{a.start}} - {{a.to}}</p>{{/if}}
          {{/each}}
        </div>
      </div>
    </div>
  </div>


  <div class="personal-info">
    <div class="ui top attached big label">Education Info</div>
    <div class="basic-info-text">
      <div class="ui list">
        <div class="large item">
          <div class="ui {{#if (eq major ../userInfo.major)}}yellow {{else}} blue {{/if}} small horizontal label">Major</div>
          <br>
          <p>{{major}}</p>
        </div>
      </div>
      <div class="ui list">
        <div class="item">
          <div class="ui {{#if (eq campus ../userInfo.campus)}}yellow {{else}} blue {{/if}}small horizontal label">Penn State Campus</div>
          <br>
          <p>{{campus}}</p>
        </div>
      </div>

      <div class="ui list">
        <div class="item">
          <div class="ui {{#if (eq goals ../userInfo.goals)}}yellow {{else}} blue {{/if}}small horizontal label">What I want to gain from World Campus</div>
          <br>
          <p>{{goals}}</p>
        </div>
      </div>
      <div class="ui list">
        <div class="item">
          <div class="ui {{#if (eq courses ../userInfo.courses)}}yellow {{else}} blue {{/if}} small horizontal label">Current Courses</div>
          <br>
          <p>{{courses}}</p>
        </div>
      </div>
      <div class="ui list">
        <div class="item">
          <div class="ui {{#if (eq reccourses ../userInfo.reccourses)}}yellow {{else}} blue {{/if}}small horizontal label">Courses I Recommend</div>
          <br>
          <p>{{reccourses}}</p>
        </div>
      </div>
      <div class="ui list">
        <div class="item">
          <div class="ui {{#if (eq instructors ../userInfo.instructors)}}yellow {{else}} blue {{/if}}small horizontal label">Instructors I Recommend</div>
          <br>
          <p>{{instructors}}</p>
        </div>
      </div>
    </div>
  </div>

  <div class="basic-info">
    <div class="ui top attached big label">Professional Info</div>
    <div class="basic-info-text">
      <div class="ui list">
        <div class="large item">
          <div class="ui {{#if (eq profession ../userInfo.profession)}}yellow {{else}} blue {{/if}} small horizontal label">Current Profession</div>
          <select disabled class="ui fluid dropdown profession" name="profession" id="profession">
            {{#select profession}}
            <option value="17">Architecture and Engineering</option>
            <option value="27">Arts, Design, Entertainment, Sports, and Media</option>
            <option value="37">Building and Grounds Cleaning and Maintenance</option>
            <option value="13">Business and Financial Operations</option>
            <option value="21">Community and Social Service</option>
            <option value="15">Computer and Mathematical</option>
            <option value="47">Construction and Extraction</option>
            <option value="25">Education, Training, and Library</option>
            <option value="45">Farming, Fishing, and Forestry</option>
            <option value="35">Food Preparation and Serving Related</option>
            <option value="29">Healthcare Practitioners and Technical</option>
            <option value="31">Healthcare Support</option>
            <option value="49">Installation, Maintenance, and Repair</option>
            <option value="23">Legal</option>
            <option value="19">Life, Physical, and Social Science</option>
            <option value="11">Management</option>
            <option value="55">Military Specific</option>
            <option value="43">Office and Administrative Support</option>
            <option value="39">Personal Care and Service</option>
            <option value="51">Production</option>
            <option value="33">Protective Service</option>
            <option value="41">Sales and Related</option>
            <option value="53">Transportation and Material Moving</option>
            <option value="0">Other</option>
            {{/select}}
          </select>
        </div>
      </div>
      <div class="ui list">
        <div class="item">
          <div class="ui {{#if (eq military ../userInfo.military)}}yellow {{else}} blue {{/if}}small horizontal label">Military Status</div>
          <select disabled class="ui dropdown military" name="military" id="military" class="military">
          {{#select user.military}}
          <option value="ad">Active Duty</option>
          <option value="re">Reserves</option>
          <option value="ng">National Guard</option>
          <option value="vt">Veteran (No reserve service obligation remaining, individual Ready Reserve)</option>
          <option value="fm">Family member/dependent of a member of the U.S. Armed Forces or Veteran</option>
          <option value="none">None of the above</option>
          {{/select}}
        </select>
        </div>
      </div>
      {{!-- <div class="ui list">
        <div class="item">
          <div class="ui blue small horizontal label">Career Goals</div>
          <br>
          <p>{{career}}</p>
        </div>
      </div>
      <div class="ui list">
        <div class="item">
          <div class="ui blue small horizontal label">Past Careers</div>
          <br>
          <p>Example past career</p>
        </div>
      </div> --}}
    </div>
  </div>

  <div class="personal-info">
    <div class="ui top attached big label">Personal Info</div>
    <div class="basic-info-text">
      <div class="ui list">
        <div class="large item">
          <div class="ui {{#if (eq pastCities ../userInfo.pastCities)}}yellow {{else}} blue {{/if}}small horizontal label">Places I've Lived</div>
          <br>
          <p>{{pastCities}}</p>

        </div>
      </div>
      <div class="ui list">
        <div class="item">
          <div class="ui {{#if (eq likeplaces ../userInfo.likeplaces)}}yellow {{else}} blue {{/if}}small horizontal label">Places I'd Like to Visit</div>
          <br><p>{{likeplaces}}</p>
          {{!-- <p>New Zealand</p>
          <br>
          <p>California</p>
          <br>
          <p>Ireland</p> --}}
        </div>
      </div>
      <div class="ui list">
        <div class="item">
          <div class="ui {{#if (eq married ../userInfo.married)}}yellow {{else}} blue {{/if}}small horizontal label">Marital Status</div>
          <br>
          <p>{{married}}</p>
          </a>
        </div>
      </div>
      <div class="ui list">
        <div class="item">
          <div class="ui {{#if (eq kids ../userInfo.kids)}}yellow {{else}} blue {{/if}}small horizontal label">Number of Kids</div>
          <br>
          <p>{{kids}}</p>
          </a>
        </div>
      </div>
      <div class="ui list">
        <div class="item">
          <div class="ui {{#if (eq fun ../userInfo.fun)}}yellow {{else}} blue {{/if}}small horizontal label">Fun Fact</div>
          <br>
          <p>{{fun}}</p>
          </a>
        </div>
      </div>
      <div class="ui list">
        <div class="item">
          <div class="ui {{#if (eq unique ../userInfo.unique)}}yellow {{else}} blue {{/if}}small horizontal label">Things my peers should know about me</div>
          <br>
          <p>{{unique}}</p>
          </a>
        </div>
      </div>
    </div>

</section>
{{/with}}
  <div class="data" id="data" style="display:None" data-attribute='{{{json user}}}'></div>   